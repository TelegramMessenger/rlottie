{
  "name": "bazzar",
  "version": "1.0.0",
  "description": "BAZZAR — Платформа управления проектами и бизнесом с ИИ инструментами",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --experimental-sqlite --watch --import tsx/esm src/server/index.ts",
    "dev:client": "npx vite --port 5173",
    "build": "npx vite build && npx tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "db:init": "node --experimental-sqlite --import tsx/esm src/server/db/migrate.ts",
    "db:seed": "node --experimental-sqlite --import tsx/esm src/server/db/seed.ts",
    "type-check": "npx tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^8.3.1",
    "@tanstack/react-query": "^5.100.11",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.29.0",
    "fastify-plugin": "^4.5.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.14"
  }
}

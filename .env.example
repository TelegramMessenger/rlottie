# ── Сервер ──────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── База данных ──────────────────────────────────────────────────
# Путь к SQLite файлу (создаётся автоматически при первом запуске)
DB_PATH=./data/bazzar.db

# ── KIE.AI ──────────────────────────────────────────────────────
# ВАЖНО: ключ хранится ТОЛЬКО на сервере, никогда не в браузере!
# Получить ключ: https://kie.ai/dashboard/api
KIE_API_KEY=your_kie_api_key_here

# ── Webhook ─────────────────────────────────────────────────────
# Базовый URL для callback от KIE.AI (должен быть публичным)
# Для разработки используй ngrok: ngrok http 3000
WEBHOOK_BASE_URL=https://your-domain.com

# Секрет для верификации webhook от KIE.AI (?token=… в callBackUrl)
# Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_in_production

# ── Аутентификация ───────────────────────────────────────────────
# Секретный ключ для подписи JWT-токенов (генерировать случайно!)
# openssl rand -base64 64
JWT_SECRET=CHANGE_ME_in_production_use_long_random_string

# ── CORS ─────────────────────────────────────────────────────────
# Разрешённые домены (через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
